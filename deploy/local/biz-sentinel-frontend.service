[Unit]
Description=Biz Sentinel Nuxt frontend
After=network-online.target biz-sentinel-backend.service
Wants=network-online.target

[Service]
Type=simple
User=biz-sentinel-web
Group=biz-sentinel-web
WorkingDirectory=/opt/biz-sentinel/current/frontend
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=13000
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/opt/biz-sentinel/runtime/node /opt/biz-sentinel/current/frontend/server/index.mjs
Restart=on-failure
RestartSec=5
MemoryMax=512M
CPUQuota=50%
TasksMax=64
Nice=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
