{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Commerce: 初始化或启动数据库",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/commerce-dev.ps1",
        "database"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Commerce: 安装前端依赖",
      "type": "shell",
      "command": "pnpm",
      "args": ["install", "--frozen-lockfile"],
      "options": { "cwd": "${workspaceFolder}/data-agent-frontend-nuxt" },
      "problemMatcher": []
    },
    {
      "label": "Commerce: 查看本地登录凭据",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/commerce-dev.ps1",
        "credentials"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
